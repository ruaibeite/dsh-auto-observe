{
  "name": "@ruaibeite/dsh-auto-observe",
  "version": "0.1.0",
  "description": "Records the edit target's current version as an observation when the agent never used the read tool (bash/sed/awk inspection does not count), so the fs observation policy stops rejecting edits with FS_NOT_OBSERVED.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruaibeite/dsh-auto-observe.git"
  },
  "homepage": "https://github.com/ruaibeite/dsh-auto-observe#readme",
  "bugs": {
    "url": "https://github.com/ruaibeite/dsh-auto-observe/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fs",
    "observation-policy",
    "edit"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/contract.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
